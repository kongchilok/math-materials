{
  "school": "○○高中",
  "grade": "高一",
  "subject": "數學科",
  "exam_name": "",
  "scope": "第一學段　單元三　指數與對數（4.1～4.4、指對數運算、指數方程、對數方程）",
  "footer_text": "高一數學科　公式參考紙",
  "sections": [
    {
      "title": "4.1 指數運算",
      "formulas": [
        { "name": "n 次方根的定義",
          "formula": "若 {x^n=a}，則 x 叫做 a 的 n 次方根，記作 {sqrt[n](a)}",
          "note": "{n>1}，n 為正整數" },
        { "name": "奇數次方根",
          "formula": "n 為奇數：{a>0} 時 {x>0}；{a<0} 時 {x<0}",
          "note": "奇數次方根唯一存在" },
        { "name": "偶數次方根",
          "formula": "n 為偶數：{a>0} 時 {x=+-sqrt[n](a)}（兩個）；{a<0} 時不存在偶次方根",
          "note": "負數沒有偶次方根" },
        { "name": "零的 n 次方根",
          "formula": "{sqrt[n](0)=0}",
          "note": "0 的任何次方根都是 0" },
        { "name": "根式性質①",
          "formula": "{(sqrt[n](a))^n=a}",
          "note": "" },
        { "name": "根式性質②（n 為奇數）",
          "formula": "{sqrt[n](a^n)=a}",
          "note": "n 為奇數" },
        { "name": "根式性質②（n 為偶數）",
          "formula": "{sqrt[n](a^n)=|a|}",
          "note": "n 為偶數，結果要取絕對值" },
        { "name": "正分數指數冪",
          "formula": "{a^{frac(m,n)}=sqrt[n](a^m)}",
          "note": "{a>0}；m、n 為正整數；{n>1}" },
        { "name": "負分數指數冪",
          "formula": "{a^{-frac(m,n)}=frac(1,sqrt[n](a^m))}",
          "note": "{a>0}；m、n 為正整數；{n>1}" },
        { "name": "冪的乘方",
          "formula": "{(a^m)^n=a^{m*n}}",
          "note": "{a>0}" }
      ]
    },
    {
      "title": "4.2 指數函數",
      "formulas": [
        { "name": "指數函數的定義",
          "formula": "{y=a^x}",
          "note": "底數 {a>0} 且 {a!=1}" },
        { "name": "定義域",
          "formula": "定義域＝{R}",
          "note": "" },
        { "name": "值域",
          "formula": "值域＝{(0,+∞)}",
          "note": "{a^x>0} 對所有 x 恆成立" },
        { "name": "必過定點",
          "formula": "圖像必過 {(0,1)}",
          "note": "因為 {a^0=1}" },
        { "name": "單調性",
          "formula": "{a>1} 時 {y=a^x} 單調遞增；{0<a<1} 時 {y=a^x} 單調遞減",
          "note": "" },
        { "name": "同底冪相乘",
          "formula": "{a^m*a^n=a^{m+n}}",
          "note": "同底相乘，指數相加" },
        { "name": "同底冪相除",
          "formula": "{frac(a^m,a^n)=a^{m-n}}",
          "note": "同底相除，指數相減" }
      ]
    },
    {
      "title": "4.3 反函數",
      "formulas": [
        { "name": "互為反函數的定義",
          "formula": "{f(g(x))=x} 且 {g(f(x))=x}",
          "note": "f 與 g 互為反函數；反函數「撤銷」原函數的作用" },
        { "name": "定義域與值域互換",
          "formula": "反函數的定義域＝原函數的值域；反函數的值域＝原函數的定義域",
          "note": "" },
        { "name": "圖像對稱性",
          "formula": "{y=f(x)} 與 {y=f^{-1}(x)} 的圖像關於直線 {y=x} 對稱",
          "note": "" },
        { "name": "坐標互換",
          "formula": "若點 {(a,b)} 在原函數上，則點 {(b,a)} 在反函數上",
          "note": "" },
        { "name": "求反函數的方法",
          "formula": "由 {y=f(x)} 對調 x 與 y 得 {x=f(y)}，解出 y，寫成 {y=f^{-1}(x)}",
          "note": "" }
      ]
    },
    {
      "title": "4.4 對數函數",
      "formulas": [
        { "name": "對數的定義",
          "formula": "若 {a^x=N}，則 {x=fn(log)_a(N)}",
          "note": "{a>0}、{a!=1}、{N>0}；讀作「以 a 為底 N 的對數」" },
        { "name": "對數函數的定義",
          "formula": "{y=fn(log)_a(x)}",
          "note": "{a>0} 且 {a!=1}" },
        { "name": "與指數函數的關係",
          "formula": "{y=fn(log)_a(x)} 是 {y=a^x} 的反函數",
          "note": "" },
        { "name": "定義域",
          "formula": "定義域＝{(0,+∞)}",
          "note": "真數 x 必須大於 0" },
        { "name": "值域",
          "formula": "值域＝{R}",
          "note": "" },
        { "name": "必過定點",
          "formula": "圖像必過 {(1,0)}",
          "note": "因為 {fn(log)_a(1)=0}" },
        { "name": "單調性",
          "formula": "{a>1} 時 {y=fn(log)_a(x)} 單調遞增；{0<a<1} 時 {y=fn(log)_a(x)} 單調遞減",
          "note": "" },
        { "name": "與指數函數的對稱性",
          "formula": "{y=fn(log)_a(x)} 與 {y=a^x} 的圖像關於直線 {y=x} 對稱",
          "note": "" },
        { "name": "對數運算法則（積）",
          "formula": "{fn(log)_a(M*N)=fn(log)_a(M)+fn(log)_a(N)}",
          "note": "{M>0}、{N>0}、{a>0}、{a!=1}；乘積變和" },
        { "name": "對數運算法則（商）",
          "formula": "{fn(log)_a(frac(M,N))=fn(log)_a(M)-fn(log)_a(N)}",
          "note": "{M>0}、{N>0}、{a>0}、{a!=1}；商變差" },
        { "name": "對數運算法則（冪）",
          "formula": "{fn(log)_a(M^n)=n*fn(log)_a(M)}",
          "note": "{M>0}、{a>0}、{a!=1}；冪變係數" },
        { "name": "對數的特殊值",
          "formula": "{fn(log)_a(1)=0}",
          "note": "{a>0}、{a!=1}" }
      ]
    },
    {
      "title": "指對數運算",
      "formulas": [
        { "name": "指數式與對數式互換",
          "formula": "{a^b=N}　{⟺}　{fn(log)_a(N)=b}",
          "note": "{a>0}、{a!=1}、{N>0}" },
        { "name": "對數恆等式",
          "formula": "{a^{fn(log)_a(N)}=N}",
          "note": "{a>0}、{a!=1}、{N>0}" },
        { "name": "底數自身的對數",
          "formula": "{fn(log)_a(a)=1}",
          "note": "{a>0}、{a!=1}" },
        { "name": "換底公式",
          "formula": "{fn(log)_a(N)=frac(fn(log)_b(N),fn(log)_b(a))}",
          "note": "{a>0}、{a!=1}、{b>0}、{b!=1}、{N>0}" }
      ]
    },
    {
      "title": "指數方程",
      "formulas": [
        { "name": "同底則指數相等",
          "formula": "{a^x=a^y}　{⇒}　{x=y}",
          "note": "{a>0}、{a!=1}" },
        { "name": "合併同類項原理",
          "formula": "先把方程中同為 {a^x} 的項合併（提公因式），再化同底比指數",
          "note": "" },
        { "name": "換元法（指數方程）",
          "formula": "方程出現 {a^{2x}} 與 {a^x} 且形如二次方程時，設 {t=a^x}（{t>0}），解出 t 後代回 {a^x=t}",
          "note": "因 {a^x>0} 恆成立，解出的 t 若為負數或 0 必須捨去" }
      ]
    },
    {
      "title": "對數方程",
      "formulas": [
        { "name": "直接轉換原理",
          "formula": "{fn(log)_a(f(x))=b}　{⇒}　{f(x)=a^b}",
          "note": "{a>0}、{a!=1}" },
        { "name": "真數檢驗",
          "formula": "解出 x 後必須代回原方程，確認所有真數（log 括號內的式子）{>0}",
          "note": "對數方程的必要檢驗步驟，不可略過" },
        { "name": "合併對數後比較真數",
          "formula": "{fn(log)_a(M)+fn(log)_a(N)=fn(log)_a(M*N)}；兩邊底數相同時真數相等",
          "note": "{M>0}、{N>0}、{a>0}、{a!=1}" },
        { "name": "換底比較",
          "formula": "兩個對數底數不同時，用換底公式化成同底，再比較真數",
          "note": "" },
        { "name": "換元法（對數方程）",
          "formula": "方程出現 {(fn(log)_a(x))^2} 與 {fn(log)_a(x)} 且形如二次方程時，設 {t=fn(log)_a(x)}，解出 t 後代回",
          "note": "代回解出 x 後仍須檢驗真數大於 0" }
      ]
    }
  ]
}
